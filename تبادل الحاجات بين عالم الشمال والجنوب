<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#0877bd">
<title>مغامرة الثروة المائية في العالم العربي</title>
<style>
:root{--blue:#0877bd;--blue2:#dff4ff;--ink:#17324a;--green:#16834b;--gold:#ffca55}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:linear-gradient(180deg,#eaf8ff,#fff 45%,#f4fbff);font-family:Tahoma,Arial,sans-serif;color:var(--ink);line-height:1.7}
main{width:min(100%,900px);margin:auto;padding:clamp(10px,3vw,24px)}
header{text-align:center;background:#0877bd;color:white;padding:18px 14px;border-radius:20px 20px 0 0}
h1{font-size:clamp(1.25rem,5vw,2rem);margin:0}
header p{margin:4px 0 0;font-size:clamp(.9rem,3vw,1.05rem)}
.card{background:white;padding:clamp(8px,2vw,16px);border:3px solid #1685c9;border-top:0;border-radius:0 0 20px 20px;box-shadow:0 5px 18px #0b47731a}
.poster{display:block;width:100%;height:auto;border-radius:12px}
.hint{text-align:center;font-size:.95rem;color:#315b77;margin:10px 4px 0}
.game{margin-top:22px;background:white;border:2px solid #a9d9f4;border-radius:20px;padding:clamp(14px,3vw,24px);box-shadow:0 7px 22px #0b47731a}
.game h2{text-align:center;color:#075b95;font-size:clamp(1.25rem,4.5vw,1.8rem);margin:0 0 8px}
.sub{text-align:center;color:#49677d;margin:0 0 16px}
.status{display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;font-weight:bold;margin:8px 0}
.track{height:10px;background:#e7f1f7;border-radius:20px;overflow:hidden;margin-bottom:18px}
.fill{height:100%;width:0;background:linear-gradient(90deg,#0b8ed0,#19ae91);transition:width .2s}
.question{font-size:clamp(1.1rem,4vw,1.4rem);font-weight:bold;margin:12px 0}
.answers{display:grid;gap:10px}
.answer{width:100%;min-height:54px;text-align:right;border:2px solid #c6dceb;border-radius:14px;background:#f8fcff;padding:12px 15px;font:inherit;font-size:1rem;font-weight:bold;color:#17324a;cursor:pointer;touch-action:manipulation}
.answer:focus-visible,.action:focus-visible{outline:3px solid #f0a900;outline-offset:3px}
.answer:disabled{cursor:default;opacity:1}
.answer.correct{border-color:#16834b;background:#e6f7ed;color:#105c36}
.answer.wrong{border-color:#d04444;background:#fff0f0;color:#922d2d}
.feedback{margin-top:14px;padding:12px 14px;background:#f0f7fb;border-radius:12px;display:none}
.feedback.show{display:block}
.action{border:0;border-radius:14px;background:var(--blue);color:white;font:inherit;font-weight:bold;font-size:1.05rem;padding:13px 20px;min-height:52px;cursor:pointer;touch-action:manipulation;width:100%;margin-top:14px}
.action.secondary{background:#16834b}
.result{display:none;text-align:center;background:#e8f8ee;border:2px solid #8bd0a5;border-radius:16px;padding:20px;margin-top:12px}
.result.show{display:block}
.score{font-size:2.4rem;font-weight:bold;color:#126a3c}
footer{text-align:center;color:#56758a;font-size:.85rem;padding:18px 8px}
@media(min-width:700px){.answers{grid-template-columns:1fr 1fr}.answer{min-height:68px}}
@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto;transition:none!important}}
</style>
</head>
<body>
<main>
<header>
<h1>💧 مغامرة الثروة المائية في العالم العربي</h1>
<p>اقرأ البطاقة، ثم انزل إلى الأسفل واختبر معلوماتك</p>
</header>
<section class="card" aria-label="البطاقة التعليمية">
<img class="poster" src="data:image/png;base64," alt="بطاقة تعليمية عن الثروة المائية في العالم العربي">
<p class="hint">📖 خذ وقتك في قراءة البطاقة. اللعبة موجودة مباشرة أسفلها.</p>
</section>

<section class="game" aria-label="اللعبة التفاعلية">
<h2>🎮 اختبر معلوماتك</h2>
<p class="sub">أجب عن الأسئلة لتحصل على نقاطك. لا تحتاج إلى تسجيل دخول أو تنزيل تطبيق.</p>
<div id="quiz">
<div class="status"><span id="counter">السؤال 1 من 7</span><span id="points">⭐ النقاط: 0</span></div>
<div class="track"><div class="fill" id="progress"></div></div>
<div class="question" id="question" aria-live="polite"></div>
<div class="answers" id="answers"></div>
<div class="feedback" id="feedback" role="status" aria-live="polite"></div>
<button class="action" id="next" type="button" hidden>السؤال التالي ←</button>
</div>
<div class="result" id="result" aria-live="polite">
<div style="font-size:2.2rem">🏆</div>
<h2>انتهت المغامرة!</h2>
<div class="score" id="finalScore"></div>
<p id="message"></p>
<button class="action secondary" id="restart" type="button">🔄 العب من جديد</button>
</div>
</section>
<footer>🌱 الماء ثروة ثمينة، فلنحافظ عليه جميعاً.</footer>
</main>
<script>
const questions = [
 {q:"بماذا يتصف العالم العربي من حيث موارده المائية؟",o:["وفرة المياه والأمطار المنتظمة","قلة الموارد المائية وعدم انتظام الأمطار","كثرة البحيرات العذبة"],a:1,e:"الموارد المائية قليلة، والأمطار غير منتظمة والأنهار محدودة."},
 {q:"ما مصادر المياه العذبة المذكورة في البطاقة؟",o:["الأنهار والمياه الجوفية والمتساقطات","مياه البحار فقط","المحيطات فقط"],a:0,e:"مصادر المياه العذبة هي الأنهار والمياه الجوفية والمتساقطات."},
 {q:"ما النهر الذي يُعد من أهم أنهار العالم العربي؟",o:["الأمازون","السين","النيل"],a:2,e:"نهر النيل من أهم أنهار العالم العربي."},
 {q:"ما النهران المهمان في العراق؟",o:["النيل والعاصي","دجلة والفرات","الأردن والعاصي"],a:1,e:"نهرا دجلة والفرات من أهم أنهار العراق."},
 {q:"ما الحل للحصول على مياه عذبة من مياه البحر؟",o:["تحلية المياه","زيادة ملوحة المياه","تلويث المياه"],a:0,e:"تحلية المياه تزيل الأملاح من مياه البحر للحصول على مياه عذبة."},
 {q:"لماذا نعالج مياه الصرف الصحي؟",o:["لزيادة التلوث","لجعلها أكثر ملوحة","لإعادة استخدامها بعد المعالجة المناسبة"],a:2,e:"تساعد المعالجة على إعادة استخدام المياه والحد من التلوث."},
 {q:"أي تصرف يساعد على المحافظة على المياه؟",o:["ترك الصنبور مفتوحاً","إصلاح التسربات وترشيد الاستهلاك","الإسراف في ري المزروعات"],a:1,e:"إصلاح التسربات وترشيد الاستهلاك يساعدان على حماية الثروة المائية."}
];
let index=0, score=0, answered=false;
const $=id=>document.getElementById(id);
function render(){
 const q=questions[index]; answered=false;
 $("counter").textContent=`السؤال ${index+1} من ${questions.length}`;
 $("points").textContent=`⭐ النقاط: ${score}`;
 $("progress").style.width=`${index/questions.length*100}%`;
 $("question").textContent=q.q;
 $("answers").innerHTML="";
 $("feedback").className="feedback"; $("feedback").textContent="";
 $("next").hidden=true;
 q.o.forEach((option,n)=>{
  const b=document.createElement("button");
  b.type="button"; b.className="answer";
  b.textContent=["أ","ب","ج"][n]+" ـ "+option;
  b.addEventListener("click",()=>choose(n));
  $("answers").appendChild(b);
 });
}
function choose(n){
 if(answered)return; answered=true;
 const q=questions[index], buttons=[...$("answers").children];
 buttons.forEach((b,j)=>{
  b.disabled=true;
  if(j===q.a)b.classList.add("correct");
  else if(j===n)b.classList.add("wrong");
 });
 if(n===q.a)score++;
 $("points").textContent=`⭐ النقاط: ${score}`;
 $("feedback").textContent=(n===q.a?"🎉 أحسنت! إجابة صحيحة. ":"💡 ليست الإجابة الصحيحة. ")+q.e;
 $("feedback").className="feedback show";
 $("next").textContent=index===questions.length-1?"🏆 عرض النتيجة":"السؤال التالي ←";
 $("next").hidden=false;
}
$("next").addEventListener("click",()=>{
 if(index<questions.length-1){index++;render();}
 else finish();
});
function finish(){
 $("quiz").hidden=true; $("result").classList.add("show");
 $("progress").style.width="100%";
 $("finalScore").textContent=`${score} / ${questions.length}`;
 $("message").textContent=score>=6?"خبير الثروة المائية! 🌟 أحسنت جداً.":score>=4?"مستكشف مائي متميز! 👏 أداء جيد.":"واصل التعلم، راجع البطاقة ثم حاول مرة أخرى. 💧";
}
$("restart").addEventListener("click",()=>{
 index=0;score=0;$("quiz").hidden=false;$("result").classList.remove("show");render();
 window.scrollTo({top:$("game").offsetTop-8,behavior:"smooth"});
});
render();
</script>
</body>
</html>
